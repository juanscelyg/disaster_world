<?xml version="1.0"?>
<model>
  <name>nathan_benderson_island_trees</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Juan S. Cely G.</name>
    <email>juanscelyg@gmail.com</email>
  </author>
  <description>
    263 oak and pine trees on the grass of the island of disaster_nathan_benderson_park_world
    (none within 20 m of the parking garage nor on the gas station pavements), grouped in a
    single static model so they do not fill the entity tree. Tree poses are in the world frame,
    so the model is included at the origin. Meshes and textures are copies of the Fuel models
    "Oak tree" (version 7) and "Pine Tree" (version 6), licensed under Creative Commons Zero
    v1.0 Universal.
  </description>
</model>
