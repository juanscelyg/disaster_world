<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gas_station">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/gas_station.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/gas_station.dae</uri>
          </mesh>
        </geometry>
        <!-- PBR material: the original Ogre 1 material script is not supported by ogre2 -->
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/GasStation_Diffuse.png</albedo_map>
              <normal_map type="object">materials/textures/GasStation_Normal.png</normal_map>
              <roughness>0.8</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
