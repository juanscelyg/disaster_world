<?xml version="1.0"?>
<model>
  <name>pavement_plane</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
  </author>
  <description>
    50 x 50 m pavement ground plane. Local copy of the Fuel model "Pavement Plane"
    (https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pavement%20Plane), version 2,
    with a PBR material instead of the Ogre 1 material script so the texture is rendered with ogre2,
    and a 50 x 50 m box collision under the tiles instead of the infinite plane.
    Licensed under Creative Commons Attribution 4.0 International.
  </description>
</model>
