<?xml version="1.0"?>
<model>
  <name>fire_truck</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
  </author>
  <description>
    Fire truck. Local copy of the Fuel model "Fire truck"
    (https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire%20truck), version 3,
    with the body texture next to the mesh so the material finds it. Some parts use
    textures of the suv model through model://suv.
