<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="disaster_baylands_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Baylands Park, Sunnyvale (CA) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.412173071650805</latitude_deg>
      <longitude_deg>-121.998878727967</longitude_deg>
      <elevation>38</elevation>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/baylands</uri>
      <name>baylands</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Victims -->
    <include>
      <uri>model://rescue_randy_sitting</uri>
      <name>rescue_randy_sitting_1</name>
      <pose>-75 -120 0.6 0 0 0</pose>
    </include>

    <include>
      <uri>model://rescue_randy_sitting</uri>
      <name>rescue_randy_sitting_2</name>
      <pose>-190 -40 1.6 0 0 0</pose>
    </include>

    <include>
      <uri>model://survivor_female</uri>
      <name>survivor_female</name>
      <pose>-135 -190 0.4 0 0 0</pose>
    </include>

    <include>
      <uri>model://survivor_male</uri>
      <name>survivor_male</name>
      <pose>-5 -272 0.8 0 0 0</pose>
    </include>

    <include>
      <uri>model://rescue_randy_sitting</uri>
      <name>rescue_randy_sitting_3</name>
      <pose>-113 -217 0.8 0 0 0</pose>
    </include>
  </world>
</sdf>
