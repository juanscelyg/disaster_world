<?xml version="1.0"?>
<model>
  <name>power_plant</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
  </author>
  <description>
    Power plant. Local copy of the Fuel model "Power Plant"
    (https://fuel.gazebosim.org/1.0/OpenRobotics/models/Power%20Plant), version 3,
